# Salin file ini menjadi .env (untuk lokal) atau set di Vercel > Settings > Environment Variables
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=masukkan_api_key_gemini_anda_disini

# Sistem kode akses (gerbang login sebelum masuk ke generator) — proyek Supabase
# "bayusetiadji07's Project" (id: wddfpmsurcftapbczise), tabel sigatot_access_codes.
# service_role key WAJIB dirahasiakan: Supabase Dashboard > Project Settings > API > service_role secret.
# JANGAN PERNAH pakai anon/publishable key di sini — service_role bisa bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=masukkan_service_role_key_supabase_disini

# Webhook Lynk.id (auto-generate kode akses saat ada pembelian) — lihat api/lynk-webhook.js.
# Daftarkan URL webhook di Lynk.id sbg: https://domain-anda/api/lynk-webhook?key=NILAI_DI_BAWAH_INI
# Buat secret ini sendiri (string acak panjang, mis. generate lewat https://1password.com/password-generator/), JANGAN ditebak-tebak.
LYNK_WEBHOOK_SECRET=buat_string_acak_panjang_sendiri_disini
# Opsional: hanya proses webhook kalau nama produk mengandung teks ini (kosongkan utk proses semua produk di akun Lynk.id Anda)
LYNK_PRODUCT_FILTER=Si Gatot

# Resend (https://resend.com) — kirim email otomatis berisi kode akses ke pembeli.
# WAJIB verifikasi domain sendiri di Resend Dashboard > Domains supaya bisa kirim ke email pembeli
# sungguhan (sandbox default cuma bisa kirim ke email pemilik akun Resend sendiri).
RESEND_API_KEY=masukkan_resend_api_key_disini
RESEND_FROM_EMAIL=noreply@domainanda.com
