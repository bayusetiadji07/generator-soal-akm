# Salin file ini menjadi .env (untuk lokal) atau set di Vercel > Settings > Environment Variables
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=masukkan_api_key_gemini_anda_disini

# Sistem akses "signup email + approval admin" — proyek Supabase "bayusetiadji07's Project"
# (id: wddfpmsurcftapbczise), tabel sigatot_profiles. Pembeli signup pakai email (magic link,
# tanpa password), lalu menunggu disetujui admin di halaman /admin sebelum bisa memakai generator.
# service_role key WAJIB dirahasiakan: Supabase Dashboard > Project Settings > API > service_role secret.
# JANGAN PERNAH pakai anon/publishable key di sini — service_role bisa bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=masukkan_service_role_key_supabase_disini

# Password utk membuka /admin (halaman menyetujui/mencabut akses akun pembeli). Buat sendiri,
# panjang & acak, JANGAN dipakai ulang dari password lain.
ADMIN_PASSWORD=buat_password_admin_sendiri_disini
